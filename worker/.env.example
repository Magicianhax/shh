KEYPAIR_PATH=/home/<user>/.config/solana/provider.json

# --- which models this worker answers for --------------------------------
#
# INFERENCE_PROVIDER picks the backend. The worker then serves every model of
# that provider in the shared catalog (client/src/models.ts), and a job's
# model_label is the exact catalog id the requester chose.
#
# MODELS narrows that to a subset, comma-separated. Leave it unset to serve all.
#
# PRICE_FLOOR_MULTIPLIER scales the catalog's suggested price into this
# worker's floor: floor = catalog priceSol x multiplier. Jobs priced under a
# model's floor are left open for a cheaper provider. 1.0 means "the catalog
# price is my price"; 1.5 asks half again as much; 0.8 undercuts the catalog.
#
# MODEL_MAP is for when the backend calls a model something else — an Ollama
# tag, or a hosted model that was renamed. JSON, catalog id -> backend id.
# Anything not listed maps to itself.

INFERENCE_PROVIDER=anthropic  # anthropic | openai | ollama
# MODELS=claude-opus-5,claude-fable-5-1
# PRICE_FLOOR_MULTIPLIER=1.0
# MODEL_MAP={"llama3.1:8b":"llama3.1:8b-instruct-q5_K_M"}

# --- backend credentials and endpoints -----------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1   # no API key needed — Ollama serves locally with no auth

MAX_OUTPUT_TOKENS=1024
POLL_MS=5000
RECONCILE_MS=30000
MIN_TIME_LEFT_S=30
