KEYPAIR_PATH=/home/<user>/.config/solana/provider.json
MODEL_LABEL=claude            # what requesters must put in the job's model label to match this worker
INFERENCE_PROVIDER=anthropic  # anthropic | openai | ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_MODEL=llama3.2:1b            # no API key needed — Ollama serves locally with no auth
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
MAX_OUTPUT_TOKENS=1024
POLL_MS=5000
RECONCILE_MS=30000
MIN_TIME_LEFT_S=30
